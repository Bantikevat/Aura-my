{
  "manifest_version": 3,
  "name": "AURA FormPilot",
  "version": "1.0.0",
  "description": "Fills job application forms from your AURA career vault in one click. You review and submit.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "AURA FormPilot", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "commands": {
    "fill-form": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fill this job form from AURA vault"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["sync.js"],
      "run_at": "document_idle"
    }
  ]
}
